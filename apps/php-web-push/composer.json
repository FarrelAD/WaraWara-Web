{
  "name": "warawara/php-web-push",
  "description": "PHP implementation of native Web Push notifications",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2 || ^8.3",
    "ext-curl": "*",
    "ext-openssl": "*",
    "ext-mbstring": "*",
    "ext-bcmath": "*",
    "ext-json": "*",
    "minishlink/web-push": "^11.0",
    "vlucas/phpdotenv": "^5.6",
    "guzzlehttp/guzzle": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "start": "php -S 0.0.0.0:8000 -t public public/router.php",
    "test": "phpunit tests",
    "analyse": "phpstan analyse --level=8",
    "lint": "php-cs-fixer fix --dry-run --diff",
    "lint:fix": "php-cs-fixer fix",
    "format": "php-cs-fixer fix",
    "format:check": "php-cs-fixer fix --dry-run --diff",
    "check": ["@analyse", "@test", "@lint"]
  }
}
