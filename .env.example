# ==============================================================================
# Web Push Notification Environment Configuration
# Copy this file to .env and configure your credentials:
#   cp .env.example .env
#
# To generate a new cryptographic VAPID keypair, run:
#   pnpm generate-vapid
# ==============================================================================

# Server Port (default: 3000 for Node.js, 3001 for Bun)
PORT=3000

# VAPID Public Key (Safe to expose to browser clients via /api/vapid-public-key)
VAPID_PUBLIC_KEY=

# VAPID Private Key (CONFIDENTIAL: Keep secret on server, NEVER commit to git!)
VAPID_PRIVATE_KEY=

# Contact URL or mailto: address required by vendor Push Services (FCM, Mozilla, Apple)
# Example: mailto:admin@yourdomain.com or https://yourdomain.com/contact
VAPID_SUBJECT=mailto:admin@example.com
